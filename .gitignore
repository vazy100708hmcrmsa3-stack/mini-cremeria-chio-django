Set-Content -Path .gitignore -Value @"
# Entorno virtual
venv/
env/
ENV/
# Archivos compilados de Python
__pycache__/
*.py[cod]
*`$py.class
# Base de datos local
db.sqlite3
db.sqlite3-journal
# Archivos de configuracion local
.env
local_settings.py
# Archivos de sistema operativo
.DS_Store
Thumbs.db
# Configuracion del editor
.vscode/
.idea/
"@